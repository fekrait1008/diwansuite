    {
      "@id": "https://diwansuite.com/ar/board-management-system#faq",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "هل يدعم النظام تشكيل المجلس والعضويات والأدوار؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. يدعم ضبط هيكل المجلس والعضويات وفترات السريان والأدوار والصلاحيات ضمن سجل موحد.",
            "inLanguage": "ar-SA"
          }
        },
        {
          "@type": "Question",
          "name": "هل يدعم إعداد محاضر مجلس الإدارة واعتمادها؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. يدعم إعداد المحاضر ومراجعتها واعتمادها والتوقيع الإلكتروني وربطها بالقرارات والمرفقات.",
            "inLanguage": "ar-SA"
          }
        },
        {
          "@type": "Question",
          "name": "كيف تتم متابعة قرارات المجلس؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "تُحوَّل القرارات إلى مهام أو التزامات تنفيذية مع مسؤول واضح وموعد استحقاق وحالة تنفيذ وتنبيهات عند التأخير.",
            "inLanguage": "ar-SA"
          }
        },
        {
          "@type": "Question",
          "name": "هل توجد قدرات ذكاء اصطناعي داخل هذا المسار؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. يدعم الذكاء الاصطناعي التلخيص، واستخراج القرارات، واقتراح مهام تنفيذية، وتحسين وضوح صياغة القرار، مع اعتماد نهائي بشري.",
            "inLanguage": "ar-SA"
          }
        },
        {
          "@type": "Question",
          "name": "هل النظام مناسب للبيئات الرقابية والجهات الحساسة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. يدعم سجل التدقيق، والصلاحيات الدقيقة، والطابع الزمني، وحماية الوثائق والقرارات الحساسة.",
            "inLanguage": "ar-SA"
          }
        },
        {
          "@type": "Question",
          "name": "هل يدعم الاجتماعات الحضورية والافتراضية والهجينة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. يدعم النماذج التشغيلية الثلاثة مع حضور ونصاب ومحاضر مرتبطة بالقرار والمتابعة.",
            "inLanguage": "ar-SA"
          }
        }
      ]
